// Publish these rules from the Firebase console (Firestore Database > Rules). They are the actual access control, not hidden UI buttons.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Students may only CREATE their own bounded-size submission; no client can read student records. (Administrators can read and delete.)
    // This covers the four built-in drills AND custom forms: every attempt is saved with the same set of top-level fields.
    match /submissions/{id} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.keys().hasOnly(['id','facet','driverName','grade','date','data','score','createdAt','userId']) && request.resource.data.driverName is string && request.resource.data.driverName.size() <= 80; allow read, update, delete: if admin(); }

    // Everyone can READ the practice calendar, the published course layouts, and the custom practice forms (students need them to
    // record a practice). Only administrators can create, change, or delete them.
    match /events/{id} { allow read: if true; allow write: if admin(); }
    match /courses/{id} { allow read: if true; allow write: if admin(); }
    match /customForms/{id} { allow read: if true; allow write: if admin(); }

    // Site settings, one document each. Everyone may read `scoring` (the scoring settings: a guest's on-the-spot score must use the
    // same rules the Analysis page shows). The other settings documents (`scoringExamples`, the example data on the Scoring settings
    // page, and `calendarExport`, the team Google Calendar ID and last export summary) are administrator-only. Only administrators write.
    match /settings/{id} { allow read: if id == 'scoring' || admin(); allow write: if admin(); }

    // Territory Breakthrough matches (the Offensive / Defensive practice). The two scoring laptops share ONE small document per match,
    // addressed by its short match code: anyone signed in (the anonymous recorder identity is enough) can open a match whose code they
    // know, create one, and update it, but nobody except an administrator can LIST matches, so codes cannot be browsed. The document
    // holds only the set-up and the live round state; scores are saved as ordinary submissions (administrator-only to read).
    match /matches/{id} {
      allow get: if signedIn();
      allow list: if admin();
      allow create: if signedIn() && request.resource.data.id == id && id.size() <= 12 && request.resource.data.keys().hasOnly(['id','createdAt','date','mode','drivers','grades','course','robots','scorers','coach','round','status','ready','done','startAt','restart','probe','host']);
      allow update: if signedIn() && request.resource.data.id == id;
      allow delete: if admin();
    }

    // The list of administrator accounts. Only an existing administrator can see or change it.
    match /admins/{id} { allow read, write: if admin(); }
  }
}
